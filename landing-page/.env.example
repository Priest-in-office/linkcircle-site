# Copy to .env.local for local development; set the same two in the Cloudflare Worker → Settings → Build → Variables and secrets.
# They are baked in at build time, so redeploy after changing them.
# From Supabase → Project Settings → API. Use the public anon / publishable key ONLY — never service_role / secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
