# Copy to .env.local for local development; set the same two in Cloudflare Pages → Settings → Variables and Secrets.
# From Supabase → Project Settings → API. Use the public anon / publishable key ONLY — never service_role / secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
